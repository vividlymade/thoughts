    "@sveltejs/adapter-node": "https://pkg.pr.new/sveltejs/kit/@sveltejs/adapter-node@12973",
    "@sveltejs/kit": "https://pkg.pr.new/sveltejs/kit/@sveltejs/kit@12973",
    "@sveltejs/vite-plugin-svelte": "4.0.1",
    "@swc/core": "1.9.2",
    "@tailwindcss/vite": "4.1.18",
    "@types/howler": "2.2.12",
    "@types/node": "25.0.10",
    "@types/pg-large-object": "2.0.7",
    "@types/ws": "8.18.1",
    "bun": "1.3.5",
    "bun-types": "1.3.5",
    "emoji-mart": "5.6.0",
    "esbuild-decorators": "1.0.0",
    "howler": "2.2.4",
    "pg": "8.16.3",
    "pg-large-object": "2.0.0",
    "reflect-metadata": "0.2.2",
    "sharp": "0.34.5",
    "svelte": "5.49.1",
    "svelte-easy-crop": "5.0.0",
    "svelte-portal": "2.2.1",
    "svelte-spa-router": "4.0.1",
    "tailwindcss": "4.1.18",
    "ts-node": "10.9.2",
