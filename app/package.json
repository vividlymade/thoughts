    "vite-tsconfig-paths": "6.1.1",
    "ws": "8.18.3"
  },
  "scripts": {
    "dev-server": "vite dev",
    "db:migration:generate": "node --import tsx --env-file ../.env ./node_modules/typeorm/cli.js migration:generate -d src\\lib\\server\\globals.ts",
    "db:migration:init": "node --import tsx --env-file ../.env ./node_modules/typeorm/cli.js migration:generate -d src\\lib\\server\\globals.ts migrations/InitializeDatabase -t 1",
    "db:migration:create": "node --import tsx --env-file ../.env ./node_modules/typeorm/cli.js migration:create",
    "db:migration:run": "node --import tsx --env-file ../.env ./node_modules/typeorm/cli.js migration:run -d src\\lib\\server\\globals.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --project=Chromium"
  },
  "trustedDependencies": [
    "@sveltejs/kit",
    "@swc/core",
    "bun",
    "esbuild",
    "sharp"
  ]
}
